# ========================
# VYL BOUQUET - PRODUCTION
# ========================

# Environment
NODE_ENV=production

# Server Configuration
PORT=3000
HOSTNAME=vylbouquet.com
HOST=0.0.0.0

# Database Configuration (UPDATE SESUAI cPANEL!)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vylz6754_vyl_bouquet_db
DB_USER=vylz6754_vylbouquet
DB_PASSWORD=Vyl@bouquet_123
DB_DIALECT=mysql

# Database Pool (Optimasi untuk cPanel)
DB_POOL_MAX=3
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Authentication
JWT_SECRET=vylbouquet-secret-key-production-2024-change-this
JWT_EXPIRES_IN=7d

# NextAuth (jika digunakan)
NEXTAUTH_URL=https://vylbouquet.com
NEXTAUTH_SECRET=vylbouquet-nextauth-secret-2024-change-this

# API Base URL
NEXT_PUBLIC_BASE_URL=https://vylbouquet.com
NEXT_PUBLIC_API_URL=https://vylbouquet.com/api

# WhatsApp Configuration
WHATSAPP_NUMBER=6282000000000
WHATSAPP_API_URL=https://api.whatsapp.com/send

# Upload Configuration
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/webp

# Memory & Performance
KEEP_ALIVE_TIMEOUT=5000
NODE_OPTIONS=--max-old-space-size=512

# Logging
LOG_LEVEL=error
